{
  "name": "one-launcher",
  "private": true,
  "version": "0.2.0",
  "license": "MIT",
  "description": "Universal game library and launcher for Steam, GOG.com, Epic Games Store, and Xbox / PC Game Pass on macOS and Windows.",
  "author": "One Launcher Contributors",
  "repository": {
    "type": "git",
    "url": "https://github.com/Space-Cadet0/One-Launcher.git"
  },
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run --config vitest.config.ts --fileParallelism=false",
    "test:unit": "vitest run --config vitest.config.ts --fileParallelism=false",
    "test:native-asan": "node scripts/test-xbox-bridge-asan.cjs",
    "test:live-smoke": "vitest run --config vitest.live.config.ts",
    "typecheck": "tsc -b && tsc -p tsconfig.test.json --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "build:macos-helpers": "node scripts/build-macos-helpers.cjs",
    "build:xbox-bridge": "node scripts/build-xbox-bridge.cjs",
    "electron": "electron electron/main.cjs",
    "desktop": "electron electron/main.cjs",
    "build:mac": "npm run build:xbox-bridge && npm run build:macos-helpers && npm run build && electron-builder --mac dir --publish never",
    "dist:mac": "npm run build:xbox-bridge && npm run build:macos-helpers && npm run build && electron-builder --mac --publish never",
    "build:win-uninstaller": "node scripts/windows-uninstaller/verify-uninstaller.cjs && MAKENSIS=$(find \"$HOME/Library/Caches/electron-builder\" -path \"*/mac/makensis\" 2>/dev/null | head -n 1) && NSISDIR=$(dirname $(dirname \"$MAKENSIS\")) \"$MAKENSIS\" build/standalone-uninstaller.nsi",
    "build:win": "npm run build:xbox-bridge && npm run build && electron-builder --win --x64 --publish never && npm run build:win-uninstaller && cp \"build/Uninstall-OneLauncher.ps1\" \"release/Uninstall-OneLauncher.ps1\" && cp \"build/Uninstall One Launcher (Full Clean).bat\" \"release/Uninstall One Launcher (Full Clean).bat\""
  },
  "build": {
    "appId": "com.onelauncher.app",
    "productName": "One Launcher",
    "icon": "build/icon.png",
    "electronLanguages": [
      "en-US"
    ],
    "afterPack": "build/afterPack.cjs",
    "mac": {
      "icon": "build/icon.icns",
      "category": "public.app-category.games",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "dir",
          "arch": [
            "arm64"
          ]
        }
      ],
      "files": [
        "electron/bin/*/darwin/**/*",
        "electron/helpers/*.dylib",
        "electron/helpers/bin/**/*",
        "!electron/assets/*.ico"
      ],
      "asarUnpack": [
        "electron/bin/*/darwin/**/*",
        "electron/helpers/*.dylib",
        "electron/helpers/bin/**/*",
        "electron/assets/**/*"
      ],
      "hardenedRuntime": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "gatekeeperAssess": false,
      "extendInfo": {
        "NSLocalNetworkUsageDescription": "One Launcher uses your local network to support multiplayer games and storefront services.",
        "NSDocumentsFolderUsageDescription": "One Launcher accesses your Documents folder to read and sync game configuration and save files.",
        "NSDownloadsFolderUsageDescription": "One Launcher accesses your Downloads folder when importing game installers.",
        "NSDesktopFolderUsageDescription": "One Launcher accesses your Desktop folder when managing game shortcuts.",
        "NSRemovableVolumesUsageDescription": "One Launcher accesses external drives to scan and launch games installed on removable storage."
      }
    },
    "dmg": {
      "icon": "build/icon.icns"
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "dir",
          "arch": [
            "x64"
          ]
        }
      ],
      "files": [
        "electron/bin/*/win32/**/*",
        "electron/helpers/bin/**/*",
        "!electron/assets/*.icns"
      ],
      "asarUnpack": [
        "electron/bin/*/win32/**/*",
        "electron/helpers/bin/**/*",
        "electron/assets/**/*"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "include": "build/installer.nsh"
    },
    "files": [
      "dist/**/*",
      "electron/*.cjs",
      "electron/ipc/**/*",
      "electron/launcher/**/*",
      "electron/storefronts/**/*",
      "electron/utils/**/*",
      "electron/helpers/bin/**/*",
      "electron/assets/**/*",
      "!**/*tokens*.json",
      "!**/auth.json",
      "!**/user.json",
      "!electron/*BaseGames*.json",
      "!node_modules/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release"
    }
  },
  "devDependencies": {
    "@tanstack/react-virtual": "^3.14.22",
    "@types/node": "^22.13.4",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "axios": "^1.7.9",
    "dompurify": "^3.4.17",
    "electron": "^44.9.3",
    "electron-builder": "^26.15.3",
    "hls.js": "^1.7.3",
    "idb-keyval": "^6.3.0",
    "lucide-react": "^0.475.0",
    "postcss": "^8.5.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vitest": "^5.0.4"
  },
  "overrides": {
    "postcss-selector-parser": "^7.1.7"
  }
}
