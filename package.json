{
  "name": "one-launcher",
  "private": true,
  "version": "0.1.0",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "electron": "electron electron/main.cjs",
    "desktop": "electron electron/main.cjs",
    "build:mac": "npm run build && electron-builder --mac dir --publish never",
    "dist:mac": "npm run build && electron-builder --mac --publish never",
    "build:win-uninstaller": "MAKENSIS=$(find \"$HOME/Library/Caches/electron-builder\" -path \"*/mac/makensis\" 2>/dev/null | head -n 1) && NSISDIR=$(dirname $(dirname \"$MAKENSIS\")) \"$MAKENSIS\" build/standalone-uninstaller.nsi",
    "build:win": "npm run build && electron-builder --win --x64 --publish never && npm run build:win-uninstaller"
  },
  "build": {
    "appId": "com.onelauncher.app",
    "productName": "One Launcher",
    "icon": "build/icon.png",
    "mac": {
      "icon": "build/icon.icns",
      "category": "public.app-category.games",
      "target": [
        { "target": "dmg", "arch": ["arm64"] },
        { "target": "dir", "arch": ["arm64"] }
      ],
      "hardenedRuntime": false,
      "gatekeeperAssess": false
    },
    "dmg": {
      "icon": "build/icon.icns"
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        { "target": "nsis", "arch": ["x64"] },
        { "target": "dir", "arch": ["x64"] }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "include": "build/installer.nsh"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "electron/bin/**/*"
    ],
    "directories": {
      "output": "release"
    }
  },
  "dependencies": {
    "@types/dompurify": "^3.0.5",
    "axios": "^1.7.9",
    "cheerio": "^1.0.0",
    "clsx": "^2.1.1",
    "dompurify": "^3.4.16",
    "hls.js": "^1.7.3",
    "lucide-react": "^0.475.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "postcss": "^8.5.2",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vitest": "^5.0.4"
  }
}
